# Server
ENVIRONMENT=development
PORT=8000

# Supabase (Project/API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Database (Alembic / SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# MQTT / HiveMQ
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=gezi_backend_service

# E2Payments (M-Pesa)
E2PAYMENTS_CLIENT_ID=
E2PAYMENTS_CLIENT_SECRET=
E2PAYMENTS_WALLET_ID=

# JWT Auth (If not fully delegating to Supabase)
JWT_SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
